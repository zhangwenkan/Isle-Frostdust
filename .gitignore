# Godot-generated cache and exports
.godot/
*.tmp
export.cfg
export_presets.cfg

# Analysis images, videos, experiments and review backups: never upload.
/artifacts/

# Editable authoring sources and backups are not required to play the game.
*.blend
*.blend[0-9]*
*.fbx
*.obj
*.mp4
*.mov
*.webm
*.gif
*.apng
*.zip
*.7z
*.bak

# Tool caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db

# Existing Phaser/Vite prototype
node_modules/
dist/
.vscode/
dist-ssr/
*.local

